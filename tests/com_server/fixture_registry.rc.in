// Real Windows REGISTRY resources, with source bytes owned by the repo.
// The two Microsoft resources are exact pinned upstream bytes, not copies
// generated from synthetic text or transformed into RCDATA.
#include "@PROJECT_SOURCE_DIR@/tests/com_server/fixture_registry_ids.h"
IDR_OPENATL_VALUE REGISTRY "@_openatl_fixture_value_rgs@"
IDR_OPENATL_AUX REGISTRY "@_openatl_fixture_aux_rgs@"
OPENATL_AUX_NAMED REGISTRY "@_openatl_fixture_aux_rgs@"
OPENATL_PARAMETERS REGISTRY "@PROJECT_SOURCE_DIR@/tests/com_server/rgs_parameters.rgs"
IDR_OPENATL_APPID REGISTRY "@PROJECT_SOURCE_DIR@/tests/com_server/rgs_appid.rgs"
IDR_MICROSOFT_CHAIN REGISTRY "@_openatl_fixture_chain_rgs@"
IDR_MICROSOFT_OUTER REGISTRY "@_openatl_fixture_outer_rgs@"
IDR_WRONG_RESOURCE_TYPE RCDATA "@_openatl_fixture_value_rgs@"

STRINGTABLE
BEGIN
    IDS_OPENATL_ERROR L"OpenWTL resource error \x4e2d\x6587"
    IDS_OPENATL_ERROR_LONG L""
END
