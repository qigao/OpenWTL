#include <windows.h>
// Own fixtures; pinned Microsoft resources are unchanged.
601 DIALOGEX 0, 0, 160, 100
STYLE DS_SETFONT | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "OpenWTL control dialog"
FONT 8, "MS Shell Dlg"
BEGIN
    CONTROL "{8856F961-340A-11D0-A96B-00C04FD705A2}", 701, "AtlAxWinLic140", WS_CHILD | WS_VISIBLE | WS_TABSTOP, 0, 0, 160, 100
END

602 DIALOG 0, 0, 80, 40
STYLE WS_POPUP | WS_CAPTION
CAPTION "OpenWTL plain dialog"
BEGIN
    LTEXT "native", 702, 4, 4, 60, 10
END

603 DIALOGEX 0, 0, 160, 100
STYLE WS_POPUP | WS_CAPTION
BEGIN
    CONTROL "{8856F961-340A-11D0-A96B-00C04FD705A2}", 701, "AtlAxWin140", WS_CHILD | WS_VISIBLE, 0, 0, 80, 100
    CONTROL "{182D5BA7-3348-4CCE-B4D5-CAD98C7A3DA1}", 703, "AtlAxWin140", WS_CHILD | WS_VISIBLE, 80, 0, 80, 100
END

604 DIALOGEX 0, 0, 80, 40
STYLE DS_NOFAILCREATE | WS_POPUP
BEGIN
    LTEXT "unsupported partial creation", 702, 0, 0, 80, 20
END

605 DIALOG 0, 0, 80, 40
STYLE WS_POPUP
BEGIN
    LTEXT "persistence initialization", 702, 0, 0, 80, 20
END
605 240
BEGIN
    0
END

OPENATL_PLAIN DIALOG 0, 0, 80, 40
STYLE WS_POPUP
BEGIN
    LTEXT "named resource", 702, 0, 0, 80, 20
END
