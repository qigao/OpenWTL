// Existing ATL core native target's real Win32 STRINGTABLE resources.
// Explicit UTF-8 encoding for both Windows SDK rc.exe and llvm-rc.
#pragma code_page(65001)
#define IDS_CSTRING_LONG 43001
#define IDS_CSTRING_CJK 43002
#define IDS_CSTRING_EMBEDDED_NUL 43003

STRINGTABLE
BEGIN
    IDS_CSTRING_LONG ""
    IDS_CSTRING_CJK "中文"
    IDS_CSTRING_EMBEDDED_NUL "A\000B"
END
