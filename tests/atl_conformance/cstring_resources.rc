// Existing ATL core native target's real Win32 STRINGTABLE resources.
// ASCII source with explicit UTF-16 wide literals for rc.exe and llvm-rc.
// Avoid depending on preprocessor/code-page handling of narrow UTF-8 literals.
#define IDS_CSTRING_LONG 43001
#define IDS_CSTRING_CJK 43002
#define IDS_CSTRING_EMBEDDED_NUL 43003

STRINGTABLE
BEGIN
    IDS_CSTRING_LONG ""
    IDS_CSTRING_CJK L"\x4e2d\x6587"
    IDS_CSTRING_EMBEDDED_NUL L"A\000B"
END
